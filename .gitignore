@'
# Python virtual environments
.venv/
.venv-*/
venv/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Local environment secrets
.env

# Generated application outputs
app/outputs/
outputs/
'@ | Set-Content -Encoding utf8 .gitignore