# ── LLM ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=your_hf_token_here

# ── ElevenLabs ────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # Rachel (default) — change to any voice ID

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=your_google_oauth_client_id
YOUTUBE_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
YOUTUBE_CHANNEL_ID=your_channel_id_here

# ── Pipeline Config ───────────────────────────────────────────────────────────
NUM_IMAGES=5
VIDEO_FPS=8
VIDEO_FRAMES=16
MAX_RETRIES=3
OUTPUT_DIR=/app/outputs

# ── Scraper Config ────────────────────────────────────────────────────────────
SCRAPE_INTERVAL_HOURS=6     # How often to auto-scrape
HF_SCRAPE_LIMIT=10          # Max topics from HuggingFace
DEVPOST_SCRAPE_LIMIT=10     # Max topics from DevPost

# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
